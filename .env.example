# Keep APP_MODE=demo on localhost only. Never expose the demo to the internet.
APP_MODE=demo
PUBLIC_ORIGIN=http://localhost:3000
INTERNAL_API_TOKEN=localhost-proxy-demo-token
# Local non-Docker mode defaults to .data/bouquetbrowse.db. Docker supplies PostgreSQL.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=bouquet-media
OPENAI_API_KEY=
# Generation is explicit; a Groq key is never sent to OpenAI. Text embeddings remain OpenAI-only/optional.
MODEL_PROVIDER=openai
GROQ_API_KEY=
GROQ_PLANNER_MODEL=qwen/qwen3.8-27b
GROQ_EXTRACTION_MODEL=qwen/qwen3.8-27b
GROQ_ESCALATION_MODEL=qwen/qwen3.8-27b
# For Groq generation select MODEL_PROVIDER=groq. Legacy imports use EXTRACTION_PROVIDER=groq (or rules).
EXTRACTION_PROVIDER=rules
EXTRACTION_MODEL=gpt-6-luna
ESCALATION_MODEL=gpt-6.1-sol
EMBEDDING_MODEL=text-embedding-3-small
MONTHLY_MODEL_BUDGET_USD=100
PER_REQUEST_RESERVATION_USD=0.10
IMAGE_EMBEDDING_PROVIDER=disabled
# Pin an exact Hugging Face commit before enabling siglip in the worker.
SIGLIP_REVISION=75de2d55ec2d0b4efc50b3e9ad70dba96a7b2fa2
THREADS_ACCESS_TOKEN=
THREADS_SEARCH_APPROVED=false
THREADS_API_BASE=https://graph.threads.net/v1.0
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_GRAPH_VERSION=
INSTAGRAM_DISCOVERY_APPROVED=false
# Local Threads browser discovery stays paused until configured and validated.
DISCOVERY_ENABLED=false
RECURRING_ENABLED=false
BACKUPS_ENABLED=false
# Optional private paths: BACKUP_DIRECTORY and ALERT_DIRECTORY default under ignored .data.
PLANNER_MODEL=gpt-6.1-sol
DISCOVERY_RUN_BUDGET_USD=0.35
OFFER_BUDGET_USD=0.10
